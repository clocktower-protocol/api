{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clocktower-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ClocktowerMCP",
				"name": "CLOCKTOWER_MCP"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["ClocktowerMCP"],
			"tag": "v1"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT",
			"id": "REPLACE_WITH_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"ALCHEMY_URL_BASE": "https://base-mainnet.g.alchemy.com/v2/",
		"CLOCKTOWER_ADDRESS_BASE": "0xFaF5fc2f77b21BC188f492b827D366B03a07c61f",
		"CHAIN_ID_BASE": "8453",
		"ALCHEMY_URL_SEPOLIA_BASE": "https://base-sepolia.g.alchemy.com/v2/",
		"CLOCKTOWER_ADDRESS_SEPOLIA_BASE": "0x6A0791Cd884f2199dC8F372f6715f675D2950922",
		"CHAIN_ID_SEPOLIA_BASE": "84532",
		"X402_NETWORK": "eip155:84532",
		"X402_FACILITATOR_URL": "https://x402.org/facilitator",
		"RATE_LIMIT_REQUESTS_PER_MINUTE": "60"
	},
	"env": {
		"test": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "ClocktowerMCP",
						"name": "CLOCKTOWER_MCP"
					}
				]
			},
			"migrations": [
				{
					"new_sqlite_classes": ["ClocktowerMCP"],
					"tag": "v1"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT",
					"id": "test-rate-limit"
				}
			],
			"vars": {
				"ALCHEMY_URL_BASE": "https://base-mainnet.g.alchemy.com/v2/",
				"CLOCKTOWER_ADDRESS_BASE": "0xFaF5fc2f77b21BC188f492b827D366B03a07c61f",
				"CHAIN_ID_BASE": "8453",
				"ALCHEMY_URL_SEPOLIA_BASE": "https://base-sepolia.g.alchemy.com/v2/",
				"CLOCKTOWER_ADDRESS_SEPOLIA_BASE": "0x6A0791Cd884f2199dC8F372f6715f675D2950922",
				"CHAIN_ID_SEPOLIA_BASE": "84532",
				"X402_NETWORK": "eip155:84532",
				"X402_FACILITATOR_URL": "https://x402.org/facilitator",
				"ALCHEMY_API_KEY": "test-alchemy-key",
				"X402_RECIPIENT": "0x0000000000000000000000000000000000000001",
				"RATE_LIMIT_REQUESTS_PER_MINUTE": "2"
			}
		}
	}
}
