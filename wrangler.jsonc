{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clocktower-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ClocktowerMCP",
				"name": "CLOCKTOWER_MCP"
			},
			{
				"class_name": "RateLimiter",
				"name": "RATE_LIMITER"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["ClocktowerMCP"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["RateLimiter"],
			"tag": "v2"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT",
			"id": "REPLACE_WITH_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"ALCHEMY_URL": "https://base-mainnet.g.alchemy.com/v2/",
		"CLOCKTOWER_ADDRESS": "0xFaF5fc2f77b21BC188f492b827D366B03a07c61f",
		"RATE_LIMIT_REQUESTS_PER_MINUTE": "60"
	},
	"env": {
		"test": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "ClocktowerMCP",
						"name": "CLOCKTOWER_MCP"
					},
					{
						"class_name": "RateLimiter",
						"name": "RATE_LIMITER"
					}
				]
			},
			"migrations": [
				{
					"new_sqlite_classes": ["ClocktowerMCP"],
					"tag": "v1"
				},
				{
					"new_sqlite_classes": ["RateLimiter"],
					"tag": "v2"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT",
					"id": "test-rate-limit"
				}
			],
			"vars": {
				"ALCHEMY_URL": "https://base-mainnet.g.alchemy.com/v2/",
				"CLOCKTOWER_ADDRESS": "0xFaF5fc2f77b21BC188f492b827D366B03a07c61f",
				"ALCHEMY_API_KEY": "test-alchemy-key",
				"CDP_API_KEY_ID": "test-cdp-key-id",
				"CDP_API_KEY_SECRET": "test-cdp-key-secret",
				"X402_RECIPIENT": "0x0000000000000000000000000000000000000001",
				"RATE_LIMIT_REQUESTS_PER_MINUTE": "2"
			}
		}
	}
}
