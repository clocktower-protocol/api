# Copy this file to .dev.vars for local development with `wrangler dev`.
# .dev.vars is automatically loaded by Wrangler and is git-ignored.
# Never commit real secrets.
#
# Generate secrets, e.g.:
#   openssl rand -hex 32

# =============================================================================
# REQUIRED (core functionality)
# =============================================================================
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_URL=https://base-mainnet.g.alchemy.com/v2/

CLOCKTOWER_ADDRESS=0xFaF5fc2f77b21BC188f492b827D366B03a07c61f

# REST default when clients omit ?chainId= (decimal or CAIP-2, e.g. 8453 or eip155:8453).
# MCP, SIWE, and Builder entitlement stay on Base regardless of this value.
DEFAULT_REST_CHAIN_ID=8453

# MCP x402 payments (default off). Only the string "true" enables them.
# When off, MCP uses REST free IP + Bearer ctk_… developer keys (invalid ctk_ → 401).
MCP_X402_ENABLED=false

# Required when MCP_X402_ENABLED=true (can remain set for a later flip).
# CDP_API_KEY_ID=your-cdp-api-key-id
# CDP_API_KEY_SECRET=your-cdp-api-key-secret
# X402_RECIPIENT=0xYourWalletAddress

# =============================================================================
# OPTIONAL - The Graph (history & provider detail endpoints)
# Needed for subgraph-backed history / discovery tools and REST routes.
# =============================================================================
# Mainnet (Base) - Decentralized Gateway
# GRAPH_BASE_URL=https://gateway.thegraph.com/api/${GRAPH_API_KEY}/subgraphs/id/H26nGNfhfFZdT9BSEajo7kyK3vdiQr1EAutPMGCUMC9x

# Sepolia - Studio
# GRAPH_BASE_SEPOLIA_URL=https://api.studio.thegraph.com/query/111673/clocktower-base-sepolia/version/latest

# GRAPH_API_KEY=your-graph-api-key-here

# =============================================================================
# OPTIONAL - Developer REST API keys (ctk_…)
# Admin secret is required for mint/list/revoke (portal BFF or curl).
# Same value must be used in clocktower-developers DEVELOPER_KEYS_ADMIN_SECRET.
# Keys enabled when secret is set, unless DEVELOPER_KEYS_ENABLED=false.
# When MCP_X402_ENABLED is off (default), the same ctk_ keys authenticate MCP.
# =============================================================================
# DEVELOPER_KEYS_ADMIN_SECRET=replace-with-openssl-rand-hex-32
# DEVELOPER_KEYS_ENABLED=true
# DEVELOPER_MAX_KEYS_PER_SUBJECT=5
# DEVELOPER_RATE_LIMIT_RPM=80
# DEVELOPER_EXPENSIVE_RATE_LIMIT_RPM=40
# DEVELOPER_SUBGRAPH_DAILY_LIMIT=3000
# DEVELOPER_WRITE_RATE_LIMIT_RPM=5
# DEVELOPER_WRITE_DAILY_LIMIT=100
# DEVELOPER_DAILY_REQUEST_LIMIT=5000

# =============================================================================
# OPTIONAL - Tiered rate limits (defaults live in src/config/rateLimits.ts)
# Prepare/readiness uses write RPM + write daily (RPC simulation cost).
# =============================================================================
# Free (anonymous IP)
# FREE_RATE_LIMIT_RPM=20
# FREE_EXPENSIVE_RATE_LIMIT_RPM=3
# FREE_SUBGRAPH_DAILY_LIMIT=100
# FREE_WRITE_RATE_LIMIT_RPM=2
# FREE_WRITE_DAILY_LIMIT=20
# FREE_DAILY_REQUEST_LIMIT=500

# Builder (SIWE session cts_…) — leave entitlement IDs empty to keep Builder off
# BUILDER_SUB_ID=
# BUILDER_SUB_IDS=
# BUILDER_RATE_LIMIT_RPM=120
# BUILDER_EXPENSIVE_RATE_LIMIT_RPM=120
# BUILDER_SUBGRAPH_DAILY_LIMIT=10000
# BUILDER_WRITE_RATE_LIMIT_RPM=30
# BUILDER_DAILY_REQUEST_LIMIT=

# MCP (used when MCP_X402_ENABLED=true; unpaid MCP reuses FREE_*/DEVELOPER_* limits)
# MCP_RATE_LIMIT_RPM=300
# MCP_EXPENSIVE_RATE_LIMIT_RPM=300
# MCP_WRITE_RATE_LIMIT_RPM=60

# Legacy flat limits (prefer FREE_*/BUILDER_*/MCP_* above)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# WRITE_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# =============================================================================
# OPTIONAL - Developer safety net (Basic Auth)
# Set ENABLE_AUTH=true to require HTTP Basic Auth on /mcp and optionally /api.
# Extra layer; not a replacement for REST rate limits or MCP x402 when that flag is on.
# =============================================================================
# ENABLE_AUTH=true
# CFP_USERNAME=your-username
# CFP_PASSWORD=your-password

# Optional origin allowlist when Basic Auth is enabled.
# Comma-separated Origins. Use "*" only for local experiments (not recommended).
# CFP_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Basic Auth on REST /api routes. Production default is false.
# API_REQUIRE_BASIC_AUTH=false

# Kill switch for REST /api/* (MCP /mcp stays up). GET /api/status remains available.
# API_ENABLED=true

# CORS for browser SPAs calling /api (comma-separated origins). Unset = disabled.
# API_CORS_ALLOWED_ORIGINS=https://app.clocktower.finance,http://localhost:5173

# Vitest / local only: mock x402 facilitator
# X402_USE_MOCK_FACILITATOR=true

# =============================================================================
# OPTIONAL - Observability (Analytics Engine + scheduled alerts)
# Structured JSON logs always go to console (Workers Logs / Logpush).
# API_ANALYTICS binding is in wrangler.jsonc (dataset: api_analytics).
# =============================================================================
# OBSERVABILITY_ENABLED=true
# CF_ACCOUNT_ID=your-cloudflare-account-id
# CF_API_TOKEN=token-with-analytics-engine-read
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_WRITE_COUNT_24H=80
# ALERT_429_COUNT_24H=50
# API_ANALYTICS_DATASET=api_analytics

# Logpush (90-day retention): configure in Cloudflare dashboard
#   Workers → clocktower-api / account Logpush → Workers trace/logs → R2
#   Set R2 lifecycle expiration to 90 days.

# =============================================================================
# OPTIONAL - Production hostnames (defaults match clocktower.finance)
# =============================================================================
# API_HOST=api.clocktower.finance
# MCP_HOST=mcp.clocktower.finance
# SIWE_DOMAIN=api.clocktower.finance
