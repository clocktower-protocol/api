# Copy to .dev.vars and fill in values for local development.
ALCHEMY_API_KEY=your-alchemy-api-key
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret
X402_RECIPIENT=0xYourWalletAddress

# Optional write-tool limits
# WRITE_RATE_LIMIT_REQUESTS_PER_MINUTE=10
# PREPARE_INTENT_TTL_SECONDS=900

# Optional HTTP Basic auth for /mcp (set ENABLE_AUTH=true to enforce)
# ENABLE_AUTH=true
# CFP_USERNAME=your-username
# CFP_PASSWORD=your-password

# Optional CSRF protection. When ENABLE_AUTH=true, browser cross-origin POSTs
# carrying cached Basic credentials are rejected unless their Origin header
# matches one of these comma-separated entries. Server-to-server clients
# (which omit Origin) are unaffected.
# Use "*" to allow any Origin (NOT recommended with ENABLE_AUTH=true).
# Leave unset to deny ALL browser-set Origins (server-to-server only).
# CFP_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
