# Copy this file to .dev.vars for local development with `wrangler dev`.
# .dev.vars is automatically loaded by Wrangler and is git-ignored.
# Never commit real secrets.

# =============================================================================
# REQUIRED (core functionality)
# =============================================================================
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_URL=https://base-mainnet.g.alchemy.com/v2/

CLOCKTOWER_ADDRESS=0xFaF5fc2f77b21BC188f492b827D366B03a07c61f

CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

X402_RECIPIENT=0xYourWalletAddress

# =============================================================================
# OPTIONAL - The Graph (history & provider detail endpoints)
# These are only needed if you want to use the subgraph-backed history tools:
#   - get_subscription_history / /api/subscriptions/:id/history
#   - get_account_activity / /api/accounts/:address/activity
#   - get_subscription_details_history
#   - get_provider_profile
# =============================================================================
# Mainnet (Base) - Decentralized Gateway
# GRAPH_BASE_URL=https://gateway.thegraph.com/api/${GRAPH_API_KEY}/subgraphs/id/H26nGNfhfFZdT9BSEajo7kyK3vdiQr1EAutPMGCUMC9x

# Sepolia - Studio
# GRAPH_BASE_SEPOLIA_URL=https://api.studio.thegraph.com/query/111673/clocktower-base-sepolia/version/latest

# GRAPH_API_KEY=your-graph-api-key-here

# =============================================================================
# OPTIONAL - Rate limiting
# =============================================================================
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# WRITE_RATE_LIMIT_REQUESTS_PER_MINUTE=10
# PREPARE_INTENT_TTL_SECONDS=900

# =============================================================================
# OPTIONAL - Developer safety net (Basic Auth)
# Set ENABLE_AUTH=true to require HTTP Basic Auth on /mcp and optionally /api.
# This is an extra layer on top of x402 micropayments (never a replacement).
# =============================================================================
# ENABLE_AUTH=true
# CFP_USERNAME=your-username
# CFP_PASSWORD=your-password

# Optional CSRF protection for browsers when Basic Auth is enabled.
# Comma-separated list of allowed Origins. Use "*" to allow any (not recommended).
# CFP_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Controls whether Basic Auth is enforced on REST API routes (x402 is always required).
# Production default in wrangler.jsonc is false (x402-only). Set true only for local dev.
# API_REQUIRE_BASIC_AUTH=false
