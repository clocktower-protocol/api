{
  "name": "clocktower-api",
  "version": "1.0.0",
  "description": "REST API and MCP server for the Clocktower Protocol",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "build": "node -e \"console.log('No frontend build; wrangler bundles TypeScript on deploy')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/hono": "^2.23.0",
    "agents": "^0.13.2",
    "dayjs": "^1.11.23",
    "hono": "^4.13.14",
    "viem": "^2.55.19",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "undici": ">=7.30.1 <8",
    "axios": ">=1.20.0 <2",
    "ws": "8.21.0",
    "browserslist": ">=4.28.7 <5",
    "proxy-addr": ">=2.0.8 <3",
    "source-map-js": ">=1.2.2 <2",
    "fast-uri": ">=3.1.9 <4",
    "ip-address": ">=10.7.5 <11",
    "sharp": "0.35.5",
    "ai": ">=6.0.214 <7",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "body-parser": ">=2.4.0 <3",
    "follow-redirects": ">=1.16.1 <2",
    "tinypool": ">=2.1.2 <3",
    "launch-editor": ">=2.14.2 <3",
    "zod": "$zod",
    "abitype": ">=1.0.10",
    "vite": ">=8.2.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "core-js-pure": false,
    "@coinbase/x402": false
  }
}
