{
  "name": "clocktower-api",
  "version": "1.0.0",
  "description": "REST API and MCP server for the Clocktower Protocol",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "build": "node -e \"console.log('No frontend build; wrangler bundles TypeScript on deploy')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/hono": "^2.23.0",
    "agents": "^0.13.2",
    "dayjs": "^1.11.23",
    "hono": "^4.13.4",
    "viem": "^2.55.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "undici": "7.29.0",
    "axios": "1.19.0",
    "ws": "8.21.0",
    "browserslist": ">=4.28.7 <5"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "core-js-pure": false,
    "@coinbase/x402": false
  }
}
